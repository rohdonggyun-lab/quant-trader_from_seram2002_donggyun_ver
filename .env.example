# 한국투자증권 모의투자 (새 계좌로 발급한 앱키)
KIS_APP_KEY=
KIS_APP_SECRET=

# 모의투자 계좌번호 (12345678-01). 모의투자에 연결한 전략이 주문할 때 사용
KIS_ACCOUNT_NO=

# 접근 토큰은 data/.kis_token_mock.json에 자동으로 저장되므로 따로 적을 것이 없다.
# (토큰 파일 위치를 바꾸고 싶을 때만 KIS_TOKEN_FILE=경로 를 추가)

# 슬랙
SLACK_BOT_TOKEN=
MOCK_SLACK_CHANNEL=
PAPER_SLACK_CHANNEL=

# KRX
KRX_ID=여기에_아이디
KRX_PW=여기에_비밀번호
KRX_API_KEY=발급받은_인증키