# 한국투자증권 모의투자 (새 계좌로 발급한 앱키)
KIS_APP_KEY=
KIS_APP_SECRET=
# 모의투자 계좌번호 (12345678-01). 모의투자에 연결한 전략이 주문할 때 사용
KIS_ACCOUNT_NO=

# 접근 토큰 파일 (선택). 비워 두면 data/.kis_token_mock.json에 저장
# 토큰은 앱키마다 다르므로, 다른 앱키(예: 실습 8장)의 토큰 파일을 지정하지 않는다
KIS_TOKEN_FILE=

# 슬랙
SLACK_BOT_TOKEN=
MOCK_SLACK_CHANNEL=#seram-quant
PAPER_SLACK_CHANNEL=#paper-trading
